    <string name="language_english">English</string>
    <string name="language_swahili">Kiswahili</string>
    <string name="consent_body">When you report a price we store the market, the product, the price and the time, together with your phone number so we can prevent spam. Your phone number is never shown to other people. You can delete your account and data at any time in Settings.</string>
    <string name="consent_checkbox">I agree that my price reports and phone number are stored as described.</string>

