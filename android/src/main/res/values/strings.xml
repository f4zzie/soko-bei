    <!-- Welcome / consent -->
    <string name="welcome_title">Welcome to Soko Bei</string>
    <string name="welcome_body">See today\'s market prices for farm produce, and help others by reporting the prices you see. Prices are shown per kilogram so they are easy to compare.</string>
