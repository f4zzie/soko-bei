# Copy to .env (docker compose reads it automatically). All values below are dev defaults.
CASSANDRA_KEYSPACE=soko_bei
# NetworkTopologyStrategy replication as "dc:rf,dc:rf". Production: datacenter1:3
CASSANDRA_REPLICATION=datacenter1:1
CASSANDRA_MAX_HEAP=768M
CASSANDRA_HEAP_NEWSIZE=128M
MONGODB_DATABASE=soko_bei
# For running the backend outside compose: MONGODB_URI=mongodb://localhost:27017
# DEV_MODE=true accepts OTP 000000 and logs OTP codes. MUST be false in production.
DEV_MODE=true
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
OTP_SECRET=dev-only-otp-secret-change-me
ADMIN_TOKEN=dev-admin-token
REPORT_MAX_AGE_DAYS=14
